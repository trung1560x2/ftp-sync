# Server configuration
PORT=3000
DB_PATH=./ftp_manager.sqlite

# Security Configuration
# ENCRYPTION_KEY must be exactly 32 bytes/characters long.
# Generate one using: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=your_32_character_encryption_key_here

# AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
